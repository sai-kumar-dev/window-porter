{
  "manifest_version": 3,
  "name": "Window Porter (Legacy/ESR)",
  "short_name": "WindowPorter",
  "version": "0.3.0",
  "description": "Portable, local-only browser window snapshots with graceful tab-group fallback for older Firefox.",
  "permissions": ["tabs", "downloads", "storage", "alarms"],
  "action": {"default_title":"Window Porter","default_popup":"popup.html","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}},
  "background": {"scripts":["core.js","background.js"]},
  "commands": {"snapshot-current-window":{"suggested_key":{"default":"Ctrl+Shift+9","mac":"Command+Shift+9"},"description":"Save the current browser window as a portable Window Porter session"}},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "browser_specific_settings": {"gecko":{"id":"windowporter-legacy@local","strict_min_version":"115.0"}}
}
